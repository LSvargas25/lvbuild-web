# URL base de la API LvBuild, incluido el prefijo /api.
# Vite la incrusta al compilar (no se lee en tiempo de ejecución): en Render (Static Site) se
# define como variable de entorno del servicio y requiere un nuevo deploy al cambiarla.
#
# Local (dotnet run):        http://localhost:5142/api
# Local (docker compose):    http://localhost:8080/api
# Producción (Render):       https://lvbuild-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5142/api
